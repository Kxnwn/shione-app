generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  moods Mood[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mood {
    id        Int      @id @default(autoincrement())
    mood      String
    note      String?
    createdAt DateTime @default(now())

    userId    Int
    user      User     @relation(fields: [userId], references: [id])
}