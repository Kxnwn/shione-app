generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String?   @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  role      Role      @default(USER)
  chat      Chat[]
  journals  Journal[]
  memory    Memory[]
  moods     Mood[]

  usageSessions UsageSession[]
}

model Mood {
  id        Int      @id @default(autoincrement())
  mood      String
  note      String?
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model Journal {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model BibleVerse {
  id        Int           @id @default(autoincrement())
  verse     String
  reference String
  category  VerseCategory
}

model Chat {
  id        Int      @id @default(autoincrement())
  role      String
  message   String
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model Memory {
  id        Int            @id @default(autoincrement())
  userId    Int
  category  MemoryCategory
  key       String
  value     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id])

  @@unique([userId, key])
}

model UsageSession {
  id              Int       @id @default(autoincrement())
  userId          Int
  startedAt       DateTime  @default(now())
  lastActiveAt    DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([startedAt])
}

enum VerseCategory {
  HOPE
  PEACE
  JOY
  ANXIETY
  FEAR
  LOVE
  STRENGTH
  WISDOM
  GRATITUDE
}

enum MemoryCategory {
  PROFILE
  PREFERENCE
  GOAL
  EDUCATION
  HOBBY
}

enum Role {
  USER
  ADMIN
}
